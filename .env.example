# Public site URL used for canonical links, sitemap and Open Graph (falls back to Vercel URL)
NEXT_PUBLIC_SITE_URL=https://techhala.com

# --- Orders database (Supabase Postgres) -------------------------------------
# Apply supabase/schema.sql to the project first (SQL editor or `supabase db push`).
# Server-side only; never expose the service-role key to the browser.
# If unset, checkout still works but orders are only logged/notified, not saved.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Admin dashboard (/admin) -------------------------------------------------
# Password for the owner login. ADMIN_SESSION_SECRET signs the session cookie
# (any long random string, e.g. `openssl rand -hex 32`). /admin is disabled if
# ADMIN_PASSWORD is unset.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# --- Bank transfer / VietQR ---------------------------------------------------
# Receiving account shown to customers (with a dynamic VietQR: amount + order
# code pre-filled). BANK_CODE is a Napas short code (TCB, VCB, MB, ACB, VPB,
# BIDV, ICB, VBA, TPB, STB, ...). BANK_BIN / BANK_NAME override the built-in
# mapping when the bank is not in the list. Name must be unaccented ASCII.
# If unset, bank-transfer orders show a manual "quote your order code" notice.
BANK_CODE=TCB
BANK_BIN=
BANK_NAME=
BANK_ACCOUNT_NO=
BANK_ACCOUNT_NAME=

# --- Automatic payment reconciliation (SePay) --------------------------------
# 1. Sign up at https://my.sepay.vn and link the bank account above.
# 2. Integrations → Webhooks → Add: URL = https://<your-domain>/api/webhooks/sepay,
#    authentication = "API Key", and paste the same key here.
# Incoming transfers whose content contains an order code (TH-XXXXXXX) are matched
# and the order is marked paid automatically; the rest appear in /admin/payments.
SEPAY_API_KEY=

# --- Stock & anti-spam --------------------------------------------------------
# Default: checkout rejects lines that exceed available stock (on_hand - reserved)
# and product pages show "out of stock". Set to `backorder` to accept every order.
STOCK_MODE=
# Max orders accepted per phone number per rolling hour (default 5).
MAX_ORDERS_PER_PHONE_PER_HOUR=

# --- Notifications (optional, best effort) -----------------------------------
# New orders are sent to a Telegram chat when both are set.
# Create a bot via @BotFather, add it to your chat, get the chat id via getUpdates.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Contact form submissions are POSTed as JSON to this URL (Slack webhook, Zapier, Formspree, ...)
CONTACT_WEBHOOK_URL=
# Orders are also POSTed as JSON here (falls back to CONTACT_WEBHOOK_URL).
ORDER_WEBHOOK_URL=

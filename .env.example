# Public site URL used for canonical links, sitemap and Open Graph (falls back to Vercel URL)
NEXT_PUBLIC_SITE_URL=https://techhala.com

# Optional: contact form submissions are POSTed as JSON to this URL (Slack webhook, Zapier, Formspree, ...)
# If unset, submissions are logged server-side only.
CONTACT_WEBHOOK_URL=

# Optional: robot orders from /checkout are POSTed as JSON here (falls back to CONTACT_WEBHOOK_URL).
# If unset, orders are logged server-side only — confirm them by phone with the customer.
ORDER_WEBHOOK_URL=

# Public site URL used for canonical links, sitemap and Open Graph (falls back to Vercel URL)
NEXT_PUBLIC_SITE_URL=https://techhala.com

# --- Orders database (Supabase Postgres) -------------------------------------
# Apply supabase/schema.sql to the project first (SQL editor or `supabase db push`).
# Server-side only; never expose the service-role key to the browser.
# If unset, checkout still works but orders are only logged/notified, not saved.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Admin dashboard (/admin) -------------------------------------------------
# Password for the owner login. ADMIN_SESSION_SECRET signs the session cookie
# (any long random string, e.g. `openssl rand -hex 32`). /admin is disabled if
# ADMIN_PASSWORD is unset.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# --- Notifications (optional, best effort) -----------------------------------
# New orders are sent to a Telegram chat when both are set.
# Create a bot via @BotFather, add it to your chat, get the chat id via getUpdates.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Contact form submissions are POSTed as JSON to this URL (Slack webhook, Zapier, Formspree, ...)
CONTACT_WEBHOOK_URL=
# Orders are also POSTed as JSON here (falls back to CONTACT_WEBHOOK_URL).
ORDER_WEBHOOK_URL=
